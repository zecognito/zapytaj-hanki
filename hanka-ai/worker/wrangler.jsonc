{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanka-ai-beta",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "hanka-brain-v1"
    }
  ],
  "vars": {
    "HANKA_MODEL": "@cf/zai-org/glm-4.7-flash"
  }
}
