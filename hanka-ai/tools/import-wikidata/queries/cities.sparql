SELECT ?item ?itemLabel ?countryLabel ?countryCode ?population ?officialWebsite WHERE {
  ?item wdt:P31/wdt:P279* wd:Q515 ; wdt:P17 ?country ; wdt:P1082 ?population ; wdt:P856 ?officialWebsite .
  ?country wdt:P297 ?countryCode .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "pl,en". }
}
ORDER BY DESC(?population)
LIMIT {{LIMIT}}
OFFSET {{OFFSET}}
